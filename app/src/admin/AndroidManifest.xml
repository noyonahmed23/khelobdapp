<?xml version="1.0" encoding="utf-8"?>
<!-- ADMIN flavor (com.khelobd.admin): only AdminActivity is present/launchable.
     The app opens directly to the Admin login + dashboard. MainActivity (the
     player UI) is stripped from the merged manifest. -->
