rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Khelo BD — Cloud Firestore security rules
//
// IMPORTANT ARCHITECTURE NOTE
// This app currently authenticates users with a custom in-app login that reads
// the `users` collection directly. It does NOT use Firebase Authentication, so
// `request.auth` is always null on the server. That means role-based, per-user
// write restrictions CANNOT be enforced server-side yet — the app relies on
// client-side role checks.
//
// The rules below therefore keep the app fully functional (reads + writes are
// permitted) while already enforcing what CAN be enforced without auth:
//   • The `activity_logs` audit trail is append-only (no edits, no deletes).
//   • The super-admin settings documents are the single source of config.
//
// TO MAKE THIS TRULY SECURE (recommended next step):
//   1. Sign users in with Firebase Auth (email/password) and store the Firebase
//      UID on each `users` document.
//   2. Replace the `allow write: if true;` lines with the commented
//      `isAdmin()` / `isSelf()` guarded versions further down this file.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: true once Firebase Auth is adopted ───────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // Admin check — requires a custom claim or an admins collection lookup.
    // Usable only after Firebase Auth is enabled.
    function isAdmin() {
      return signedIn() &&
        (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'SUPER_ADMIN');
    }

    // Public, read-only reference data that every client needs to render the app.
    match /tournaments/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if isAdmin();
    }
    match /matches/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if isAdmin() || isParticipant(doc);
    }
    match /registrations/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if signedIn();
    }
    match /standings/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if isAdmin();
    }
    match /teams/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if signedIn();
    }
    match /challenges/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if signedIn();
    }
    match /user_challenges/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if isAdmin() || isParty(doc);
    }
    match /payments/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if signedIn();
    }
    match /users/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if signedIn(); (block role escalation)
    }

    // System configuration (bKash/Nagad numbers, referral bonus, maintenance).
    match /settings/{doc} {
      allow read: if true;
      allow write: if true;   // PRODUCTION: if isAdmin();
    }

    // ── Immutable audit log: create-only. No updates, no deletes, ever. ──────
    match /activity_logs/{doc} {
      allow read: if true;
      allow create: if true;  // PRODUCTION: if isAdmin();
      allow update, delete: if false;
    }

    // Deny everything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
